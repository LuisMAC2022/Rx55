<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>MVP Iteración 1 — Estacionamiento (layout real)</title>
  <style>
    body { margin: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial; }
    header {
      padding: 12px 16px; border-bottom: 1px solid #e6e6e6;
      display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
    }
    header h1 { margin: 0; font-size: 16px; font-weight: 650; }
    header .meta { color: #666; font-size: 12px; }

    .wrap { display: grid; grid-template-columns: 1fr 380px; height: calc(100vh - 57px); }
    .left { padding: 12px; overflow: auto; }
    .right { border-left: 1px solid #e6e6e6; padding: 12px; overflow: auto; }

    .toolbar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 10px; }
    input[type="search"] { padding: 8px 10px; border: 1px solid #ddd; border-radius: 8px; width: 320px; }
    button { padding: 8px 10px; border: 1px solid #ddd; border-radius: 8px; background: #fff; cursor: pointer; }
    button:active { transform: translateY(1px); }

    .legend { display: flex; gap: 10px; flex-wrap: wrap; font-size: 12px; color: #444; }
    .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; vertical-align: middle; margin-right: 6px; border: 1px solid rgba(0,0,0,.15); }
    .dot.free { background: #e8f7ee; }
    .dot.occupied { background: #e9f0ff; }
    .dot.blocked { background: #fff2e6; }
    .dot.selected { background: #111; border-color: #111; }

    .svgwrap { border: 1px solid #e6e6e6; border-radius: 12px; overflow: hidden; background: #fafafa; }
    svg { width: 100%; height: auto; display: block; }

    .spot { stroke: rgba(0,0,0,.18); stroke-width: 1; cursor: pointer; }
    .spot.free { fill: #e8f7ee; }
    .spot.occupied { fill: #e9f0ff; }
    .spot.blocked { fill: #fff2e6; }
    .spot.selected { stroke: #111; stroke-width: 2.5; }
    .spot-label { font-size: 11px; fill: rgba(0,0,0,.72); user-select: none; pointer-events: none; }
    .title { font-size: 14px; fill: rgba(0,0,0,.75); font-weight: 700; }
    .small { font-size: 11px; fill: rgba(0,0,0,.55); }
    .blk { fill:#fff; stroke: rgba(0,0,0,.12); stroke-width: 1.2; }
    .blk-label { font-size: 18px; font-weight: 800; fill: rgba(0,0,0,.55); user-select:none; pointer-events:none; }
    .aisle { fill:#f0f0f0; stroke: rgba(0,0,0,.05); }
    .arrow { stroke: rgba(0,0,0,.35); stroke-width: 2; fill:none; marker-end: url(#arrowHead); }

    .card { border: 1px solid #e6e6e6; border-radius: 12px; padding: 12px; margin-bottom: 12px; }
    .card h2 { margin: 0 0 8px 0; font-size: 14px; }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 12px; }
    .row { display: flex; justify-content: space-between; gap: 10px; }
    .k { color: #666; }
    .v { font-weight: 650; }

    select, textarea {
      width: 100%; padding: 8px 10px; border: 1px solid #ddd; border-radius: 8px; background: #fff;
      font-size: 13px;
    }
    textarea { min-height: 70px; resize: vertical; }
    .hint { font-size: 12px; color: #666; margin-top: 8px; line-height: 1.35; }

    .pill {
      display:inline-block; padding:2px 8px; border-radius: 999px;
      border:1px solid rgba(0,0,0,.12); font-size: 11px; color:#444; background:#fff;
    }
  </style>
</head>
<body>
  <header>
    <h1>Estacionamiento — Iteración 1 (layout real)</h1>
    <span class="meta">Cajones 1–51 (faltan 17 y 23) · Edificios/Deptos A–D · asignación cajón↔depto</span>
  </header>

  <div class="wrap">
    <div class="left">
      <div class="toolbar">
        <input id="search" type="search" placeholder="Buscar: cajón (40), depto (B-202), nombre..." />
        <button id="btnReset">Restablecer inventado</button>
        <button id="btnClear">Borrar cambios (local)</button>
        <div class="legend" style="margin-left:auto">
          <span><span class="dot free"></span>Libre</span>
          <span><span class="dot occupied"></span>Asignado</span>
          <span><span class="dot blocked"></span>Bloqueado</span>
          <span><span class="dot selected"></span>Seleccionado</span>
        </div>
      </div>

      <div class="svgwrap">
        <svg id="parkingSvg" viewBox="0 0 1000 780" role="img" aria-label="Plano real del estacionamiento">
          <!-- Render por JS -->
        </svg>
      </div>

      <div class="hint">
        Persistencia: <b>localStorage</b> (solo este navegador). Números <span class="pill">17</span> y <span class="pill">23</span> no existen (no se construyeron).
      </div>
    </div>

    <aside class="right">
      <div class="card">
        <h2>Seleccionado</h2>
        <div class="grid2">
          <div class="row"><span class="k">Cajón</span><span class="v" id="selSpot">—</span></div>
          <div class="row"><span class="k">Estado</span><span class="v" id="selState">—</span></div>
          <div class="row"><span class="k">Depto</span><span class="v" id="selUnit">—</span></div>
          <div class="row"><span class="k">Inquilino</span><span class="v" id="selTenant">—</span></div>
        </div>
      </div>

      <div class="card">
        <h2>Asignación cajón ↔ depto</h2>
        <label style="font-size:12px;color:#666">Asignar a:</label>
        <select id="unitSelect" disabled></select>
        <div style="display:flex; gap:8px; margin-top:10px;">
          <button id="btnAssign" disabled>Asignar</button>
          <button id="btnUnassign" disabled>Quitar</button>
        </div>
        <div class="hint">Regla MVP: un depto puede tener máximo 1 cajón (por ahora).</div>
      </div>

      <div class="card">
        <h2>Estado del cajón</h2>
        <label style="font-size:12px;color:#666">Marcar como:</label>
        <select id="stateSelect" disabled>
          <option value="free">Libre</option>
          <option value="occupied">Asignado</option>
          <option value="blocked">Bloqueado</option>
        </select>
        <div class="hint">Si lo pones en “Libre” o “Bloqueado”, se desasigna automáticamente.</div>
      </div>

      <div class="card">
        <h2>Notas (opcional)</h2>
        <textarea id="notes" placeholder="Ej: Cajón estrecho, solo compacto..." disabled></textarea>
        <div style="display:flex; gap:8px; margin-top:10px;">
          <button id="btnSaveNotes" disabled>Guardar notas</button>
        </div>
      </div>

      <div class="card">
        <h2>Detalle del depto</h2>
        <div id="unitDetail" class="hint">Selecciona un cajón para ver el depto asignado.</div>
      </div>
    </aside>
  </div>

<script>
/**
 * Layout basado en tu dibujo:
 * - Numeración real: 1..51 excluyendo 17 y 23
 * - Distribución aproximada por clusters:
 *   TL: 51,43,44,42,41,31,32
 *   TR: 50,49,48 / 45,46,47 / 40,39,38,37 / 33,34,35,36
 *   ML: 30,29 / 18,19 (sin 17)
 *   MR: 28,27,26,25 / 20,21,22,24 (sin 23)
 *   BL: 16,15,14 / 3,4,5 / 2,1
 *   BR: 13,12,11,10 / 6,7,8,9
 * - Bloques de deptos: A, B, C, D al centro (como en el dibujo)
 * - “Basura” abajo de D
 */

const LS_KEY = "parking_mvp_iter1_real_layout_v1";

// ---------- Datos inventados ----------
function seedData() {
  // Ejemplo: 16 deptos inventados distribuidos en edificios A-D
  const units = [
    { id:"UA01", building:"A", depto:"101", label:"A-101" },
    { id:"UA02", building:"A", depto:"102", label:"A-102" },
    { id:"UA03", building:"A", depto:"201", label:"A-201" },
    { id:"UA04", building:"A", depto:"202", label:"A-202" },

    { id:"UB01", building:"B", depto:"101", label:"B-101" },
    { id:"UB02", building:"B", depto:"102", label:"B-102" },
    { id:"UB03", building:"B", depto:"201", label:"B-201" },
    { id:"UB04", building:"B", depto:"202", label:"B-202" },

    { id:"UC01", building:"C", depto:"101", label:"C-101" },
    { id:"UC02", building:"C", depto:"201", label:"C-201" },
    { id:"UC03", building:"C", depto:"301", label:"C-301" },
    { id:"UC04", building:"C", depto:"401", label:"C-401" },

    { id:"UD01", building:"D", depto:"101", label:"D-101" },
    { id:"UD02", building:"D", depto:"201", label:"D-201" },
    { id:"UD03", building:"D", depto:"301", label:"D-301" },
    { id:"UD04", building:"D", depto:"401", label:"D-401" },
  ];

  const tenants = [
    { id:"T01", unit_id:"UA01", name:"María López", phone:"55 1234 0001", status:"active", notes:"" },
    { id:"T02", unit_id:"UA02", name:"Jorge Ramírez", phone:"55 1234 0002", status:"active", notes:"" },
    { id:"T03", unit_id:"UA03", name:"Ana Pérez", phone:"55 1234 0003", status:"active", notes:"" },
    { id:"T04", unit_id:"UA04", name:"Luis Hernández", phone:"55 1234 0004", status:"inactive", notes:"Mudanza reciente" },

    { id:"T05", unit_id:"UB01", name:"Karla Sánchez", phone:"55 1234 0005", status:"active", notes:"" },
    { id:"T06", unit_id:"UB02", name:"David Torres", phone:"55 1234 0006", status:"active", notes:"" },
    { id:"T07", unit_id:"UB03", name:"Paola Cruz", phone:"55 1234 0007", status:"active", notes:"" },
    { id:"T08", unit_id:"UB04", name:"Ricardo Vega", phone:"55 1234 0008", status:"active", notes:"" },

    { id:"T09", unit_id:"UC01", name:"Sofía Navarro", phone:"55 1234 0009", status:"active", notes:"" },
    { id:"T10", unit_id:"UC02", name:"Carlos Díaz", phone:"55 1234 0010", status:"active", notes:"" },
    { id:"T11", unit_id:"UC03", name:"Iván Morales", phone:"55 1234 0011", status:"active", notes:"" },
    { id:"T12", unit_id:"UC04", name:"Elena Castillo", phone:"55 1234 0012", status:"inactive", notes:"" },

    { id:"T13", unit_id:"UD01", name:"Fernanda Ruiz", phone:"55 1234 0013", status:"active", notes:"" },
    { id:"T14", unit_id:"UD02", name:"Omar Salas", phone:"55 1234 0014", status:"active", notes:"" },
    { id:"T15", unit_id:"UD03", name:"Valeria Pineda", phone:"55 1234 0015", status:"active", notes:"" },
    { id:"T16", unit_id:"UD04", name:"Héctor Luna", phone:"55 1234 0016", status:"active", notes:"" },
  ];

  // Cajones 1..51 excepto 17 y 23
  const missing = new Set([17, 23]);
  const spots = [];
  for (let n=1; n<=51; n++) {
    if (missing.has(n)) continue;
    spots.push({ id:String(n), label:String(n), unit_id:null, state:"free", notes:"", x:0, y:0, w:0, h:0 });
  }

  // Asignaciones inventadas iniciales (solo para demo)
  const assign = (spotNum, unitId) => {
    const s = spots.find(x => x.id === String(spotNum));
    if (!s) return;
    s.unit_id = unitId;
    s.state = "occupied";
  };

  assign(1,"UD01");
  assign(2,"UD02");
  assign(6,"UD03");
  assign(7,"UD04");
  assign(20,"UC01");
  assign(21,"UC02");
  assign(29,"UB01");
  assign(30,"UB02");
  assign(33,"UA01");
  assign(34,"UA02");
  assign(45,"UA03");
  assign(46,"UA04");

  // Bloqueados inventados (si quieres marcarlos)
  const block = (spotNum, notes) => {
    const s = spots.find(x => x.id === String(spotNum));
    if (!s) return;
    s.unit_id = null;
    s.state = "blocked";
    s.notes = notes || "";
  };
  block(51, "Espacio irregular");
  block(48, "Columna / difícil maniobra");

  return { units, tenants, spots };
}

function loadState() {
  const raw = localStorage.getItem(LS_KEY);
  if (!raw) return seedData();
  try {
    const parsed = JSON.parse(raw);
    if (!parsed?.spots?.length || !parsed?.units?.length || !parsed?.tenants?.length) return seedData();
    return parsed;
  } catch {
    return seedData();
  }
}
function saveState() { localStorage.setItem(LS_KEY, JSON.stringify(state)); }

let state = loadState();
let selectedSpotId = null;

// ---------- SVG helpers ----------
const svg = document.getElementById("parkingSvg");
function clearSvg() { while (svg.firstChild) svg.removeChild(svg.firstChild); }

function el(name, attrs = {}, text = null) {
  const n = document.createElementNS("http://www.w3.org/2000/svg", name);
  for (const [k,v] of Object.entries(attrs)) n.setAttribute(k, v);
  if (text !== null) n.textContent = text;
  return n;
}

function setText(id, text) { document.getElementById(id).textContent = text; }
function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
}
function getUnit(unitId) { return state.units.find(u => u.id === unitId) || null; }
function getTenantByUnit(unitId) { return state.tenants.find(t => t.unit_id === unitId) || null; }

// ---------- Layout (posiciones aproximadas del dibujo) ----------
const SPW = 54, SPH = 58, GAP = 6;

function place(spotNum, x, y) {
  const s = state.spots.find(z => z.id === String(spotNum));
  if (!s) return;
  s.x = x; s.y = y; s.w = SPW; s.h = SPH;
}

function applyLayout() {
  // TL cluster: 51 / 43 44 / 42 41 / 31 32
  const tlx = 70, tly = 120;
  place(51, tlx, tly);
  place(43, tlx, tly + (SPH+GAP)*1);
  place(42, tlx, tly + (SPH+GAP)*2);
  place(31, tlx, tly + (SPH+GAP)*3);

  place(44, tlx + (SPW+GAP)*1, tly + (SPH+GAP)*1);
  place(41, tlx + (SPW+GAP)*1, tly + (SPH+GAP)*2);
  place(32, tlx + (SPW+GAP)*1, tly + (SPH+GAP)*3);

  // TR big cluster:
  const trx = 640, try0 = 120;
  // row 1: 50 49 48
  place(50, trx + (SPW+GAP)*0, try0);
  place(49, trx + (SPW+GAP)*1, try0);
  place(48, trx + (SPW+GAP)*2, try0);
  // row 2: 45 46 47
  place(45, trx + (SPW+GAP)*0, try0 + (SPH+GAP)*1);
  place(46, trx + (SPW+GAP)*1, try0 + (SPH+GAP)*1);
  place(47, trx + (SPW+GAP)*2, try0 + (SPH+GAP)*1);
  // row 3: 40 39 38 37
  place(40, trx + (SPW+GAP)*0, try0 + (SPH+GAP)*2);
  place(39, trx + (SPW+GAP)*1, try0 + (SPH+GAP)*2);
  place(38, trx + (SPW+GAP)*2, try0 + (SPH+GAP)*2);
  place(37, trx + (SPW+GAP)*3, try0 + (SPH+GAP)*2);
  // row 4: 33 34 35 36
  place(33, trx + (SPW+GAP)*0, try0 + (SPH+GAP)*3);
  place(34, trx + (SPW+GAP)*1, try0 + (SPH+GAP)*3);
  place(35, trx + (SPW+GAP)*2, try0 + (SPH+GAP)*3);
  place(36, trx + (SPW+GAP)*3, try0 + (SPH+GAP)*3);

  // ML small cluster: 30 29 / 18 19 (sin 17)
  const mlx = 140, mly = 420;
  place(30, mlx + (SPW+GAP)*0, mly);
  place(29, mlx + (SPW+GAP)*1, mly);
  place(18, mlx + (SPW+GAP)*0, mly + (SPH+GAP)*1);
  place(19, mlx + (SPW+GAP)*1, mly + (SPH+GAP)*1);

  // MR cluster: 28 27 26 25 / 20 21 22 24 (sin 23)
  const mrx = 640, mry = 420;
  place(28, mrx + (SPW+GAP)*0, mry);
  place(27, mrx + (SPW+GAP)*1, mry);
  place(26, mrx + (SPW+GAP)*2, mry);
  place(25, mrx + (SPW+GAP)*3, mry);
  place(20, mrx + (SPW+GAP)*0, mry + (SPH+GAP)*1);
  place(21, mrx + (SPW+GAP)*1, mry + (SPH+GAP)*1);
  place(22, mrx + (SPW+GAP)*2, mry + (SPH+GAP)*1);
  place(24, mrx + (SPW+GAP)*3, mry + (SPH+GAP)*1);

  // BL cluster: 16 15 14 / 3 4 5 / 2 1
  const blx = 120, bly = 560;
  place(16, blx + (SPW+GAP)*0, bly);
  place(15, blx + (SPW+GAP)*1, bly);
  place(14, blx + (SPW+GAP)*2, bly);

  place(3,  blx + (SPW+GAP)*0, bly + (SPH+GAP)*1);
  place(4,  blx + (SPW+GAP)*1, bly + (SPH+GAP)*1);
  place(5,  blx + (SPW+GAP)*2, bly + (SPH+GAP)*1);

  place(2,  blx + (SPW+GAP)*0, bly + (SPH+GAP)*2);
  place(1,  blx + (SPW+GAP)*1, bly + (SPH+GAP)*2);

  // BR cluster: 13 12 11 10 / 6 7 8 9
  const brx = 640, bry = 560;
  place(13, brx + (SPW+GAP)*0, bry);
  place(12, brx + (SPW+GAP)*1, bry);
  place(11, brx + (SPW+GAP)*2, bry);
  place(10, brx + (SPW+GAP)*3, bry);

  place(6,  brx + (SPW+GAP)*0, bry + (SPH+GAP)*1);
  place(7,  brx + (SPW+GAP)*1, bry + (SPH+GAP)*1);
  place(8,  brx + (SPW+GAP)*2, bry + (SPH+GAP)*1);
  place(9,  brx + (SPW+GAP)*3, bry + (SPH+GAP)*1);
}

function renderSvg() {
  clearSvg();
  applyLayout();

  // defs (flechas)
  const defs = el("defs");
  const marker = el("marker", { id:"arrowHead", markerWidth:"10", markerHeight:"7", refX:"9", refY:"3.5", orient:"auto" });
  marker.appendChild(el("polygon", { points:"0 0, 10 3.5, 0 7", fill:"rgba(0,0,0,.35)" }));
  defs.appendChild(marker);
  svg.appendChild(defs);

  // fondo
  svg.appendChild(el("rect", { x:0, y:0, width:1000, height:780, fill:"#fafafa" }));

  // títulos / entradas
  svg.appendChild(el("text", { x:30, y:30, class:"title" }, "Plano (aprox.) según dibujo"));
  svg.appendChild(el("text", { x:260, y:60, class:"small" }, "MAIN ENTRANCE"));
  svg.appendChild(el("path", { d:"M300 70 L300 100", class:"arrow" }));
  svg.appendChild(el("text", { x:690, y:60, class:"small" }, "SECOND ENTRANCE"));
  svg.appendChild(el("path", { d:"M740 70 L740 100", class:"arrow" }));

  // pasillos (solo para lectura visual)
  svg.appendChild(el("rect", { x:30, y:360, width:940, height:36, class:"aisle" }));
  svg.appendChild(el("text", { x:500, y:384, class:"small", "text-anchor":"middle" }, "PASILLO"));

  // bloques deptos A-D + Basura
  const blocks = [
    { x:420, y:120, w:160, h:120, label:"A" },
    { x:440, y:260, w:140, h:105, label:"B" },
    { x:440, y:395, w:140, h:120, label:"C" },
    { x:470, y:535, w:95,  h:95,  label:"D" },
  ];
  for (const b of blocks) {
    svg.appendChild(el("rect", { x:b.x, y:b.y, width:b.w, height:b.h, rx:12, ry:12, class:"blk" }));
    svg.appendChild(el("text", { x:b.x + b.w/2, y:b.y + b.h/2 + 6, class:"blk-label", "text-anchor":"middle" }, b.label));
  }
  // Basura
  svg.appendChild(el("rect", { x:430, y:650, width:160, height:70, rx:12, ry:12, class:"blk" }));
  svg.appendChild(el("text", { x:510, y:692, class:"small", "text-anchor":"middle" }, "Basura"));

  // Spots (rect + label)
  for (const s of state.spots) {
    // seguridad: si algún spot no quedó posicionado, lo escondemos fuera
    const x = s.x ?? -9999, y = s.y ?? -9999, w = s.w ?? SPW, h = s.h ?? SPH;

    const rect = el("rect", {
      x, y, width:w, height:h, rx:8, ry:8,
      class: `spot ${s.state} ${selectedSpotId===s.id ? "selected" : ""}`,
      "data-spot-id": s.id
    });
    rect.addEventListener("click", () => selectSpot(s.id));
    svg.appendChild(rect);

    svg.appendChild(el("text", {
      x: x + w/2, y: y + h/2 + 4,
      class:"spot-label", "text-anchor":"middle"
    }, s.label));
  }

  // Etiquetas de “faltantes”
  svg.appendChild(el("text", { x:30, y:70, class:"small" }, "Nota: no existen los cajones 17 y 23 (no construidos)."));
}

// ---------- Panel derecho ----------
function fillUnitSelect() {
  const sel = document.getElementById("unitSelect");
  sel.innerHTML = "";
  sel.appendChild(new Option("— (sin asignar) —", ""));
  for (const u of state.units) sel.appendChild(new Option(`${u.label} (${u.id})`, u.id));
}

function resetRightPanel() {
  setText("selSpot", "—");
  setText("selState", "—");
  setText("selUnit", "—");
  setText("selTenant", "—");
  document.getElementById("unitSelect").disabled = true;
  document.getElementById("btnAssign").disabled = true;
  document.getElementById("btnUnassign").disabled = true;
  document.getElementById("stateSelect").disabled = true;
  document.getElementById("notes").disabled = true;
  document.getElementById("btnSaveNotes").disabled = true;
  document.getElementById("unitDetail").textContent = "Selecciona un cajón para ver el depto asignado.";
}

function renderUnitDetail(unit, tenant, spot) {
  const box = document.getElementById("unitDetail");
  if (!unit) {
    if (spot.state === "blocked") {
      box.innerHTML = `Cajón <b>${escapeHtml(spot.id)}</b> está <b>bloqueado</b>.<br/>Notas: ${escapeHtml(spot.notes || "—")}`;
    } else {
      box.innerHTML = "Cajón sin depto asignado.";
    }
    return;
  }
  box.innerHTML = `
    <div class="grid2">
      <div class="row"><span class="k">Edificio</span><span class="v">${unit.building}</span></div>
      <div class="row"><span class="k">Depto</span><span class="v">${unit.depto}</span></div>
      <div class="row"><span class="k">Etiqueta</span><span class="v">${unit.label}</span></div>
      <div class="row"><span class="k">Inquilino</span><span class="v">${tenant ? escapeHtml(tenant.name) : "—"}</span></div>
      <div class="row"><span class="k">Tel.</span><span class="v">${tenant ? escapeHtml(tenant.phone) : "—"}</span></div>
      <div class="row"><span class="k">Status</span><span class="v">${tenant ? tenant.status : "—"}</span></div>
    </div>
    <div class="hint" style="margin-top:8px">
      Nota inquilino: ${tenant ? escapeHtml(tenant.notes || "—") : "—"}
    </div>
  `;
}

function selectSpot(spotId) {
  selectedSpotId = spotId;
  const spot = state.spots.find(s => s.id === spotId);
  const unit = getUnit(spot.unit_id);
  const tenant = unit ? getTenantByUnit(unit.id) : null;

  setText("selSpot", spot.label);
  setText("selState", spot.state);
  setText("selUnit", unit ? unit.label : "—");
  setText("selTenant", tenant ? tenant.name : "—");

  document.getElementById("unitSelect").disabled = false;
  document.getElementById("btnAssign").disabled = false;
  document.getElementById("btnUnassign").disabled = false;
  document.getElementById("stateSelect").disabled = false;
  document.getElementById("notes").disabled = false;
  document.getElementById("btnSaveNotes").disabled = false;

  document.getElementById("unitSelect").value = spot.unit_id || "";
  document.getElementById("stateSelect").value = spot.state;
  document.getElementById("notes").value = spot.notes || "";

  renderUnitDetail(unit, tenant, spot);
  renderSvg();
}

// ---------- Acciones ----------
document.getElementById("btnAssign").addEventListener("click", () => {
  if (!selectedSpotId) return;
  const spot = state.spots.find(s => s.id === selectedSpotId);
  const unitId = document.getElementById("unitSelect").value || null;

  if (unitId) {
    // Regla MVP: una unidad solo puede tener 1 cajón: quitarlo de otro si existe
    for (const s of state.spots) {
      if (s.unit_id === unitId && s.id !== spot.id) {
        s.unit_id = null;
        if (s.state === "occupied") s.state = "free";
      }
    }
    spot.unit_id = unitId;
    spot.state = "occupied";
  } else {
    spot.unit_id = null;
    if (spot.state === "occupied") spot.state = "free";
  }

  saveState();
  selectSpot(selectedSpotId);
});

document.getElementById("btnUnassign").addEventListener("click", () => {
  if (!selectedSpotId) return;
  const spot = state.spots.find(s => s.id === selectedSpotId);
  spot.unit_id = null;
  if (spot.state === "occupied") spot.state = "free";
  saveState();
  selectSpot(selectedSpotId);
});

document.getElementById("stateSelect").addEventListener("change", (e) => {
  if (!selectedSpotId) return;
  const spot = state.spots.find(s => s.id === selectedSpotId);
  const newState = e.target.value;

  spot.state = newState;
  if (newState === "blocked" || newState === "free") spot.unit_id = null;

  saveState();
  selectSpot(selectedSpotId);
});

document.getElementById("btnSaveNotes").addEventListener("click", () => {
  if (!selectedSpotId) return;
  const spot = state.spots.find(s => s.id === selectedSpotId);
  spot.notes = document.getElementById("notes").value || "";
  saveState();
  selectSpot(selectedSpotId);
});

document.getElementById("btnReset").addEventListener("click", () => {
  state = seedData();
  saveState();
  selectedSpotId = null;
  resetRightPanel();
  fillUnitSelect();
  renderSvg();
});

document.getElementById("btnClear").addEventListener("click", () => {
  localStorage.removeItem(LS_KEY);
  state = seedData();
  selectedSpotId = null;
  resetRightPanel();
  fillUnitSelect();
  renderSvg();
});

// ---------- Búsqueda ----------
document.getElementById("search").addEventListener("input", (e) => {
  const q = (e.target.value || "").trim().toLowerCase();
  renderSvg();
  if (!q) return;

  const matched = new Set();
  for (const s of state.spots) {
    const sid = s.id.toLowerCase();
    if (sid.includes(q) || (s.notes||"").toLowerCase().includes(q)) matched.add(s.id);

    if (s.unit_id) {
      const u = getUnit(s.unit_id);
      const t = u ? getTenantByUnit(u.id) : null;
      if (u && (u.label.toLowerCase().includes(q) || u.depto.toLowerCase().includes(q) || u.building.toLowerCase().includes(q))) matched.add(s.id);
      if (t && (t.name.toLowerCase().includes(q) || (t.phone||"").toLowerCase().includes(q))) matched.add(s.id);
    }
  }

  for (const rect of svg.querySelectorAll("rect.spot")) {
    const id = rect.getAttribute("data-spot-id");
    rect.style.opacity = matched.has(id) ? "1" : "0.22";
  }
});

